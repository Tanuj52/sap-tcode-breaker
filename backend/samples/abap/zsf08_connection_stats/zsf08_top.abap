*&---------------------------------------------------------------------*
*& Include ZSF08_TOP
*&---------------------------------------------------------------------*
TABLES: sflight, spfli.

TYPES: BEGIN OF ty_flight,
         carrid   TYPE sflight-carrid,
         connid   TYPE sflight-connid,
         fldate   TYPE sflight-fldate,
         seatsmax TYPE sflight-seatsmax,
         seatsocc TYPE sflight-seatsocc,
       END OF ty_flight,
       BEGIN OF ty_conn,
         carrid   TYPE spfli-carrid,
         connid   TYPE spfli-connid,
         cityfrom TYPE spfli-cityfrom,
         cityto   TYPE spfli-cityto,
       END OF ty_conn,
       BEGIN OF ty_stat,
         carrid    TYPE sflight-carrid,
         connid    TYPE sflight-connid,
         flights   TYPE i,
         seatsmax  TYPE sflight-seatsmax,
         seatsocc  TYPE sflight-seatsocc,
       END OF ty_stat,
       BEGIN OF ty_out,
         carrid    TYPE sflight-carrid,
         carrname  TYPE scarr-carrname,
         connid    TYPE sflight-connid,
         cityfrom  TYPE spfli-cityfrom,
         cityto    TYPE spfli-cityto,
         flights   TYPE i,
         seatsmax  TYPE sflight-seatsmax,
         seatsocc  TYPE sflight-seatsocc,
       END OF ty_out,
       BEGIN OF ty_log,
         ts   TYPE timestampl,
         text TYPE char80,
       END OF ty_log.

DATA: gt_flight TYPE STANDARD TABLE OF ty_flight,
      gt_conn   TYPE SORTED TABLE OF ty_conn WITH UNIQUE KEY carrid connid,
      gt_stat   TYPE STANDARD TABLE OF ty_stat,
      gt_out    TYPE STANDARD TABLE OF ty_out,
      gt_scarr  TYPE SORTED TABLE OF scarr WITH UNIQUE KEY carrid,
      gt_log    TYPE STANDARD TABLE OF ty_log,
      gv_count  TYPE i,
      gv_mail   TYPE ad_smtpadr,
      go_alv    TYPE REF TO cl_salv_table.
